    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.9.1",
    "mqtt": "^5.15.2",
    "node-cron": "^4.6.0",
    "tsx": "^4.23.10",
    "typescript": "~5.8.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/node-cron": "^3.0.11"
