{
  "name": "lht-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --expose-gc --max-old-space-size=384 dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
