# MongoDB connection string (bắt buộc để lưu trữ tin tức L.H.T)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/logical-heuristic-terminal?retryWrites=true&w=majority"

# Cấu hình tên các Database chuyên biệt trên cùng cluster
NEWS_DB="lht-news"
KNOWLEDGE_DB="lht-kb"
CHAT_DB="lht-chat"
MEMORY_DB="lht-memory"

# Gemini API Key (tùy chọn — kích hoạt chế độ AI thật cho /api/lht/query)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# [ANTI-QUOTA] Nhiều API key, cách nhau dấu phẩy — system rotate khi key trước hết quota 429
# Tạo thêm project free trên https://aistudio.google.com và thêm key vào đây
GEMINI_API_KEYS="KEY2,KEY3"

# Gemini model & API version (gemini-2.5-flash-lite chạy trên /v1)
GEMINI_MODEL="gemini-2.5-flash-lite"
GEMINI_API_VERSION="v1"

# [ANTI-QUOTA] Danh sách model free (theo thứ tự ưu tiên) để rotate khi hết quota
# Sau khi tất cả key hết quota với primary model → tự động thử model tiếp theo
GEMINI_FREE_MODELS="gemini-2.5-flash-lite,gemini-2.0-flash-lite,gemini-2.0-flash,gemini-1.5-flash-8b"

# Model embedding cho Semantic Search
GEMINI_EMBED_MODEL="gemini-embedding-2"

# RSS nguồn tin tức công nghệ (Scraper pipeline)
NEWS_RSS_URL="https://genk.vn/rss/trang-chu.rss"

# Cơ sở dữ liệu tài chính riêng (LHT-finance) — hạn mức chi tiêu hằng ngày
FINANCE_DB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/LHT-finance"

# MQTT broker URL cho IoT sync (tùy chọn)
MQTT_URL="mqtt://localhost:1883"

# Cổng chạy backend (Render tự động inject biến PORT)
PORT=3001

# Bí mật bảo vệ endpoint kích hoạt pipeline thủ công /api/pipeline/run
PIPELINE_SECRET=""

# Chạy cron pipeline (00:00) chỉ khi = production
NODE_ENV="development"
